# Ports (Slot 4)
WEB_PORT=8070
API_PORT=8071
WORKER_PORT=8076
POSTGRES_PORT=8072
REDIS_PORT=8073
RABBITMQ_PORT=8074
RABBITMQ_MGMT_PORT=8075
PGADMIN_PORT=8077

# Internal app ports
INTERNAL_WEB_PORT=3000
INTERNAL_API_PORT=3001
INTERNAL_WORKER_PORT=3002

# Database
POSTGRES_DB=ajust_erp
POSTGRES_USER=ajust
POSTGRES_PASSWORD=ajust123
DATABASE_URL=postgresql://ajust:ajust123@postgres:5432/ajust_erp?schema=public

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Web internal connectivity (Docker network)
API_INTERNAL_URL=http://api:3001
WORKER_INTERNAL_URL=http://worker:3002

# Demo credentials used by web server components
WEB_DEMO_EMAIL=admin@ajust.local
WEB_DEMO_PASSWORD=Admin@123456
# WEB_TENANT_ID=

# Auth
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
SECRETS_ENCRYPTION_KEY=change-this-secret-key-in-production

# Uploads / worker
UPLOAD_ROOT=/workspace/uploads
IXC_RECONCILE_INTERVAL_MS=300000
EXPORT_RETENTION_DAYS=30
EXPORT_RETENTION_INTERVAL_MS=3600000
IXC_WEBHOOK_REQUIRE_SIGNATURE=true
IXC_MOCK_RECONCILE=true
