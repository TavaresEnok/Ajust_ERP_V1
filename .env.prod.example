# Node Environment
NODE_ENV=production

# URLs externas (Como o usuario final e o frontend irão acessar)
API_BASE_URL=https://api.seusistema.com.br
WEB_BASE_URL=https://app.seusistema.com.br

# Segurança (Altere ambos com senhas geradas e não compartilhe)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_RESET_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
SECRETS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
MONITORING_WEBHOOK_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
CHAT_WEBHOOK_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
WORKER_API_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Banco de Dados
DATABASE_URL=postgresql://ajust:CHANGE_ME@postgres:5432/ajust_erp?schema=public
POSTGRES_USER=ajust
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ajust_erp

# Redis
REDIS_URL=redis://redis:6379

# SMTP para disparo de e-mails (Recuperação de Senha, etc)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@seusistema.com.br
SMTP_PASS=CHANGE_ME
SMTP_FROM="Ajust ERP <noreply@seusistema.com.br>"
