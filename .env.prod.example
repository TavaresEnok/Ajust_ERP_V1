# Node Environment
NODE_ENV=production

# URLs externas (Como o usuario final e o frontend irão acessar)
API_BASE_URL=https://api.seusistema.com.br
WEB_BASE_URL=https://app.seusistema.com.br

# Segurança (Altere ambos com senhas geradas e não compartilhe)
JWT_ACCESS_SECRET=your_super_secret_access_key_123!
JWT_REFRESH_SECRET=your_super_secret_refresh_key_456!
SECRETS_ENCRYPTION_KEY=32_bytes_long_secret_key_for_ixc_tokens_!

# Banco de Dados
DATABASE_URL=postgresql://ajust:ajust123@postgres:5432/ajust_erp?schema=public
POSTGRES_USER=ajust
POSTGRES_PASSWORD=ajust123
POSTGRES_DB=ajust_erp

# Redis
REDIS_URL=redis://redis:6379

# SMTP para disparo de e-mails (Recuperação de Senha, etc)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@seusistema.com.br
SMTP_PASS=sua_senha_smtp
